# Defaults bind to loopback. LAN access requires APP_PASSWORD.
HOST=127.0.0.1
PORT=3000
APP_PASSWORD=
SESSION_SECRET=
# Set only when reverse proxy changes the request origin, e.g. https://your-domain.
APP_ORIGIN=
COOKIE_SECURE=false
BISHAMON_DB_PATH=data/bishamon.sqlite
LLM_DEFAULT_PROVIDER=demo
LLM_TIMEOUT_MS=45000
LLM_FALLBACK_CHAIN=
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
